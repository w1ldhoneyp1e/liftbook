{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2023"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmitOnError": true,
        "rootDir": "src",
        "outDir": "generated",
        "types": [
            "node"
        ],
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.mts"
    ]
}
