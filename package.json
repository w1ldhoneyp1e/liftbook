{
  "name": "liftbook",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node apps/backend/scripts/run-migrations.mjs",
    "cleanup:lifecycle": "node apps/backend/scripts/cleanup-lifecycle.mjs",
    "vps:up": "docker compose --env-file .env.vps -f docker-compose.vps.yml up -d --build",
    "vps:down": "docker compose --env-file .env.vps -f docker-compose.vps.yml down",
    "vps:migrate": "docker compose --env-file .env.vps -f docker-compose.vps.yml build migrate && docker compose --env-file .env.vps -f docker-compose.vps.yml run --rm migrate",
    "vps:release": "bash scripts/release-vps.sh",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "lint": "eslint apps/frontend apps/backend --ext .ts,.tsx,.js,.jsx,.mjs --fix"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-jsonc": "^2.18.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sort-exports": "^0.9.1",
    "eslint-plugin-yml": "^1.15.0",
    "globals": "^14.0.0",
    "typescript": "^5"
  }
}
